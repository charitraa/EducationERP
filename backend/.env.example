# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=INFO

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
THROTTLE_LOGIN=10/min

# Production only (PostgreSQL)
DB_NAME=education_erp
DB_USER=education_erp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=https://portal.example.edu
