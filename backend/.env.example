# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=INFO
# Where production writes errors.log (rotating). Point at a mounted volume
# so 500 tracebacks survive a redeploy.
LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Comma-separated addresses that get emailed on a 500. Blank = no email.
ADMINS=

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
THROTTLE_LOGIN=10/min

# CORS — comma-separated origins the browser may call the API from.
# Scheme + host + port, no trailing slash. Leave blank for same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=False

# Production only (PostgreSQL)
DB_NAME=education_erp
DB_USER=education_erp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CSRF_TRUSTED_ORIGINS=https://portal.example.edu
