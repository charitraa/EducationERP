# =============================================================================
# EducationERP — environment configuration
#
# Copy to .env and adjust:   cp .env.example .env
# Never commit the real .env — it is gitignored.
#
# Every variable below is read by config/settings/*.py. The listed value is
# the setting's own default unless marked REQUIRED, so you only need to edit
# what actually differs for your machine or deployment.
#
# Legend:  [all] every environment   [dev] development.py   [prod] production.py
# =============================================================================

# -----------------------------------------------------------------------------
# NOT read from this file — DJANGO_SETTINGS_MODULE must be a real environment
# variable, because it is consumed by manage.py/wsgi.py before .env is parsed.
#   manage.py  -> config.settings.development (config.settings.test when testing)
#   wsgi/asgi  -> config.settings.production
# Export it in your shell, systemd unit or container spec to override:
#   export DJANGO_SETTINGS_MODULE=config.settings.production
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Core                                                                    [all]
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string

# Never True in production — it leaks tracebacks and settings to the browser.
DEBUG=True

# Comma-separated hostnames Django will serve. Ignored in development, which
# forces ["*"]. REQUIRED in production.
ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=UTC


# -----------------------------------------------------------------------------
# Authentication / JWT                                                    [all]
# -----------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# DRF throttle rate for the login endpoint, "<number>/<period>".
# Period is one of: sec, min, hour, day.
THROTTLE_LOGIN=10/min


# -----------------------------------------------------------------------------
# CORS / CSRF                                                             [all]
# -----------------------------------------------------------------------------
# Origins the browser may call the API from. Scheme + host + port, no trailing
# slash. Blank means same-origin only. development.py already defaults to the
# usual Vite/Next ports, so you only set this to add or replace them.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Leave False while the JWT travels in the Authorization header. Set True only
# if you move refresh tokens into cookies — the frontend then also needs
# credentials: "include".
CORS_ALLOW_CREDENTIALS=False

# Seconds a browser may cache a preflight response.
CORS_PREFLIGHT_MAX_AGE=3600

# Origins trusted for CSRF. CORS does not satisfy Django's CSRF origin check,
# so a cookie/session-authenticated SPA needs its origin here too.
# Note: development.py ignores this and mirrors CORS_ALLOWED_ORIGINS instead,
# so it only takes effect in production — where it is REQUIRED if anything
# posts with a session (the Django admin counts).
CSRF_TRUSTED_ORIGINS=https://portal.example.edu


# -----------------------------------------------------------------------------
# Database — PostgreSQL                                                  [prod]
# development.py and test.py use SQLite and ignore all of these.
# -----------------------------------------------------------------------------
# The three below are REQUIRED in production — it raises on startup without
# them, deliberately, rather than silently connecting somewhere wrong.
# Note: python-decouple does not strip trailing "#" comments, so keep comments
# on their own lines or they become part of the value.
DB_NAME=education_erp
DB_USER=education_erp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Seconds to keep a connection open for reuse. 0 disables persistent
# connections; keep it at/below your PgBouncer or Postgres idle timeout.
DB_CONN_MAX_AGE=60


# -----------------------------------------------------------------------------
# Security hardening                                                     [prod]
# -----------------------------------------------------------------------------
# Redirect http -> https. Only set False when TLS terminates at a proxy that
# already does the redirect, or health checks will bounce.
SECURE_SSL_REDIRECT=True

# HSTS lifetime in seconds (31536000 = 1 year). Set 0 while testing — browsers
# honour this for the full duration and it cannot be undone quickly.
SECURE_HSTS_SECONDS=31536000


# -----------------------------------------------------------------------------
# Email                                                              [dev/prod]
# development.py prints mail to the console and ignores these; they are read
# there only so a real SMTP server can be swapped in when testing delivery.
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# For Gmail this is an app password, not the account password.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# -----------------------------------------------------------------------------
# Logging                                                            [all/prod]
# -----------------------------------------------------------------------------
# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.              [all]
LOG_LEVEL=INFO

# Directory for the rotating errors.log that captures 500 tracebacks. [prod]
# Blank uses backend/logs/. Point this at a mounted volume so tracebacks
# survive a redeploy.
LOG_DIR=

# Rotation: size per file in bytes (10485760 = 10 MB) and how many to keep.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Comma-separated addresses emailed on every 500. Blank disables it entirely;
# it also stays off unless EMAIL_HOST is set.
ADMINS=

# -----------------------------------------------------------------------------
# Docker                                                                  [dev]
# -----------------------------------------------------------------------------
# development.py uses SQLite by default so the plain venv workflow needs no
# services. The Docker dev overlay sets this to True to run the same Postgres
# as production, using the DB_* values above.
DEV_USE_POSTGRES=False
